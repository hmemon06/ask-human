# --- OpenAI (post-call extraction). The voice brain uses the key you store in the ElevenLabs dashboard. ---
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-5.4

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Secret shown when you create the post-call webhook in ElevenLabs
ELEVENLABS_WEBHOOK_SECRET=
# Only for TELEPHONY=elevenlabs (paid Twilio imported into ElevenLabs). Leave blank for the bridge.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# --- Telephony mode ---
# twilio-bridge = free: we dial with Twilio's API (trial OK) and bridge audio to ElevenLabs ourselves.
# elevenlabs    = ElevenLabs dials via a Twilio number imported into ElevenLabs (needs paid Twilio).
TELEPHONY=twilio-bridge
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Public https URL of this server (your cloudflared/ngrok tunnel). Twilio connects back to it.
PUBLIC_URL=https://xxxx.trycloudflare.com

# --- You ---
MY_PHONE_NUMBER=+1XXXXXXXXXX
USER_NAME=Haroon

# --- Server ---
PORT=3333
# Shared secret between the MCP shim and the HTTP server (any random string)
ASK_HUMAN_TOKEN=change-me
# URL the MCP shim calls (localhost while the server runs on this machine)
ASK_HUMAN_SERVER_URL=http://localhost:3333
# How long to wait for the call to resolve before returning "unavailable" (minutes)
CALL_TIMEOUT_MINUTES=30

# --- SIP trunk provider (Telnyx etc.) for TELEPHONY=elevenlabs — ElevenLabs dials out through it ---
SIP_TRUNK_NUMBER=+1XXXXXXXXXX
SIP_TRUNK_ADDRESS=sip.telnyx.com
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_TRANSPORT=auto
ELEVENLABS_OUTBOUND=sip
